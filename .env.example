# Copy to .env and fill in. Never commit .env.

# --- Embeddings ---
# local = Hugging Face model in-container (no quota) | gemini = Gemini API
EMBEDDING_PROVIDER=local
LOCAL_EMBEDDING_MODEL=google/embeddinggemma-300m
# auto | cpu | cuda  (GPU needs the GPU build: make embed GPU=1)
EMBEDDING_DEVICE=auto
LOCAL_BATCH_SIZE=64
# Document template used for indexing: full | synopsis_only
DOCUMENT_TEMPLATE=synopsis_only

# --- Gemini (https://aistudio.google.com/apikey): chat model + optional embedding provider ---
GEMINI_API_KEY=
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
GEMINI_CHAT_MODEL=gemini-2.5-flash
# JSON list, tried in order when the primary is overloaded (503) or rate-limited (429)
GEMINI_CHAT_FALLBACK_MODELS=["gemini-3.5-flash-lite"]
# 0 = no thinking for Gemini 2.x (about 3s vs 14s per explanation); empty = model default
GEMINI_THINKING_BUDGET=0
# Gemini provider only: 768 | 1536 | 3072 (local models define their own size)
EMBEDDING_DIM=768
EMBEDDING_BATCH_SIZE=50
# Quota counts each text in a batch. Free tier: 100/min -> 90. Paid tier: raise to thousands.
EMBEDDING_TEXTS_PER_MINUTE=90

# --- Qdrant ---
# Your cluster, e.g. https://xxxxxxxx.eu-central-1-0.aws.cloud.qdrant.io:6333
# For the optional local container (--profile local-qdrant) use http://qdrant:6333 and leave the key empty.
QDRANT_URL=
QDRANT_API_KEY=
QDRANT_COLLECTION=anime

# --- Serving ---
LOG_LEVEL=INFO
# console | json
LOG_FORMAT=console

# --- Hugging Face (gated models such as google/embeddinggemma-300m) ---
# https://huggingface.co/settings/tokens  (Read token; accept the model license first)
HF_TOKEN=
