# Copy to .env and fill in. Never commit .env.

# --- Gemini (https://aistudio.google.com/apikey) ---
GEMINI_API_KEY=
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
GEMINI_CHAT_MODEL=gemini-2.5-flash
# 768 | 1536 | 3072 (Matryoshka truncation; changing it requires re-embedding + re-indexing)
EMBEDDING_DIM=768
EMBEDDING_BATCH_SIZE=50
# Quota counts each text in a batch. Free tier: 100/min -> 90. Paid tier: raise to thousands.
EMBEDDING_TEXTS_PER_MINUTE=90
# Document template used for indexing: full | synopsis_only
DOCUMENT_TEMPLATE=full

# --- Qdrant ---
# Your cluster, e.g. https://xxxxxxxx.eu-central-1-0.aws.cloud.qdrant.io:6333
# For the optional local container (--profile local-qdrant) use http://qdrant:6333 and leave the key empty.
QDRANT_URL=
QDRANT_API_KEY=
QDRANT_COLLECTION=anime

# --- Serving ---
API_URL=http://api:8000
LOG_LEVEL=INFO
# console | json
LOG_FORMAT=console
